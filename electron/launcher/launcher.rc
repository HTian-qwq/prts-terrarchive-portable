            VALUE "ProductName", "PRTS Terrarchive\0"
            VALUE "ProductVersion", "0.2.0-alpha.1\0"
            VALUE "LegalCopyright", "MIT License\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
